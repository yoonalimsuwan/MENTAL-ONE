class DiffRGRefiner(nn.Module):
    """Differentiable RG coarse‑graining."""
    def __init__(self, factor: int = 4, n_levels: int = 2):
        super().__init__()
        self.factor = factor
        self.n_levels = n_levels
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if x.dim() == 1:
            x = x.unsqueeze(0)
        for _ in range(self.n_levels):
            f = self.factor
            L = x.shape[1]
            m = L // f * f
            if m == 0: break
            pooled = F.avg_pool1d(x[:, :m].unsqueeze(0), kernel_size=f, stride=f)
            up = F.interpolate(pooled, size=L, mode='linear', align_corners=True)
            x = up.squeeze(0)
        return x.squeeze(0) if x.shape[0] == 1 else x

class MentalHealthEvolution(nn.Module):
    """SOC + RG trajectory predictor for psychiatric disorders."""
    def __init__(self, soc_controller: SOCController, rg_refiner: DiffRGRefiner):
        super().__init__()
        self.soc = soc_controller
        self.rg = rg_refiner

    def forward(self, mu_sequence: torch.Tensor, steps: int = 50) -> Dict[str, torch.Tensor]:
        mu_smooth = self.rg(mu_sequence)
        future = self.soc.soc_evolve(mu_smooth, steps=steps)
        return {'future': future, 'smooth': mu_smooth}

