# 9. BV Consistency for Brain Networks
# =============================================================================
class BVConsistency:
    """Batalin–Vilkovisky check for network stability."""
    def __init__(self, adjacency: np.ndarray):
        self.adj = adjacency
    def check(self) -> bool:
        L = np.diag(self.adj.sum(axis=1)) - self.adj
        eigvals = np.linalg.eigvalsh(L)
        return np.all(eigvals >= -1e-8)

