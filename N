# 10. Advanced Trainer for SSC Prototypes and CSOC Kernel
# =============================================================================
class AdvancedTrainer:
    """
    Trains SSC prototypes and CSOC kernel parameters simultaneously
    using a multi‑disorder dataset. Uses gradient descent on total loss
    combining classification accuracy and SOC energy.
    """
    def __init__(self, n_channels: int = 19, n_timepoints: int = 256,
                 device: torch.device = OPTIMAL_DEVICE):
        self.device = device
        self.classifier = SSCClassifier(n_channels, n_timepoints).to(device)
        self.kernel = CSOCKernel().to(device)
        self.soc = SOCController(kernel=self.kernel).to(device)
        self.rg = DiffRGRefiner().to(device)
        self.evolution = MentalHealthEvolution(self.soc, self.rg).to(device)

    def train(self, dataset: MentalHealthDataset, subject_list: List[str],
              epochs: int = 100, lr: float = 1e-3):
        # Collect all data
        all_s0 = []
        all_labels = []
        for subj in subject_list:
            data = dataset.load_subject(subj)
            all_s0.append(data['s0'])
            # Convert diagnosis string to index
            diag = data['label'].item()  # assuming label is index into ALL_PSYCHIATRIC_DISORDERS
            all_labels.append(diag)
        if not all_s0:
            return
        s0_batch = torch.stack(all_s0).to(self.device)
        label_tensor = torch.tensor(all_labels, dtype=torch.long, device=self.device)

        # Initialize prototypes from data means
        for i, d in enumerate(ALL_PSYCHIATRIC_DISORDERS):
            mask = label_tensor == i
            if mask.any():
                mean_state = s0_batch[mask].mean(dim=0)
                setattr(self.classifier, f'p_{d}', mean_state)

        # Setup optimizer for CSOC kernel and SSC prototypes
        optimizer = torch.optim.Adam(
            list(self.kernel.parameters()) +
            [getattr(self.classifier, f'p_{d}') for d in ALL_PSYCHIATRIC_DISORDERS],
            lr=lr
        )

        for epoch in range(epochs):
            optimizer.zero_grad()
            total_loss = 0.0
            for i in range(len(s0_batch)):
                s0 = s0_batch[i]
                true_label = ALL_PSYCHIATRIC_DISORDERS[label_tensor[i].item()]
                # Run SSC to fixed point
                s_star = self.classifier(s0, n_iter=25,
                                         target_disorder=true_label,
                                         healthy_disorder='Healthy')
                # Classification loss (minimize energy for true class)
                E_true = self.classifier.energy(s_star, true_label, 'Healthy')
                # SOC energy on the disease burden trajectory
                mu_seq = s_star.reshape(self.classifier.n_channels, self.classifier.n_timepoints).mean(dim=0)
                evo = self.evolution(mu_seq, steps=20)
                # Use SOC energy on the smooth trajectory (via kernel)
                # For simplicity, we minimise the final energy + entropy
                loss = E_true + 0.1 * torch.mean(evo['future'])  # pull future toward low energy
                total_loss += loss
            total_loss.backward()
            optimizer.step()
            if epoch % 10 == 0:
                logger.info(f"Epoch {epoch}: loss={total_loss.item():.4f}")

