# 11. Main MENTAL ONE Engine
# =============================================================================
class MentalONEEngine:
    """Central pipeline for diagnosis, evolution, and treatment."""
    def __init__(self, device: torch.device = OPTIMAL_DEVICE):
        self.device = device
        self.loader = MultiModalDataLoader(device=device)
        self.classifier = None
        self.evolution = None
        self.intervention = InterventionDesigner()
        self.dsm5 = DSM5DiagnosisEngine()

    def initialise_from_dataset(self, dataset: MentalHealthDataset,
                                subject_list: List[str]):
        """Quick initialisation of prototypes using a small reference set."""
        all_s0 = []
        for subj in subject_list:
            data = dataset.load_subject(subj)
            all_s0.append(data['s0'])
        s0_batch = torch.stack(all_s0).to(self.device)
        n_ch = 19  # assume; adjust dynamically
        n_tp = 256
        if s0_batch.shape[1] != n_ch * n_tp:
            # infer from data
            n_tp = s0_batch.shape[1] // n_ch
        self.classifier = SSCClassifier(n_ch, n_tp).to(self.device)
        # Set prototypes from data
        for d in ALL_PSYCHIATRIC_DISORDERS:
            setattr(self.classifier, f'p_{d}', s0_batch.mean(dim=0))
        self.evolution = MentalHealthEvolution(SOCController(), DiffRGRefiner()).to(self.device)

    def run(self, eeg_file: str = None, meg_file: str = None,
            fmri_file: str = None, clinical_file: str = None,
            n_iter: int = 25) -> Dict:
        if eeg_file:
            eeg = self.loader.load_eeg(eeg_file)
        elif meg_file:
            eeg = self.loader.load_meg(meg_file)
        else:
            raise ValueError("EEG or MEG required.")
        s0 = eeg.flatten()
        s0 = (s0 - s0.min()) / (s0.max() - s0.min() + 1e-8)

        if self.classifier is None:
            # Initialize with default random prototypes (should be pre-trained)
            n_ch = eeg.shape[0]
            n_tp = eeg.shape[1]
            self.classifier = SSCClassifier(n_ch, n_tp).to(self.device)
            for d in ALL_PSYCHIATRIC_DISORDERS:
                setattr(self.classifier, f'p_{d}', torch.rand_like(s0))
            self.evolution = MentalHealthEvolution(SOCController(), DiffRGRefiner()).to(self.device)

        # SSC evolution
        s_star = self.classifier(s0, n_iter=n_iter, target_disorder='MDD', healthy_disorder='Healthy')
        diagnosis = self.classifier.classify(s_star)

        # Disease burden trajectory
        mu_seq = s_star.reshape(self.classifier.n_channels, self.classifier.n_timepoints).mean(dim=0)
        evo_result = self.evolution(mu_seq, steps=50)

        # Treatment plan
        desired_state = getattr(self.classifier, 'p_Healthy', torch.zeros_like(s_star))
        plan = self.intervention.design_plan(diagnosis, s_star, desired_state)

        report = {
            'diagnosis': diagnosis,
            'future_trajectory': evo_result['future'].tolist(),
            'treatment_plan': plan
        }
        return report

