# 8. Training Module for SSC Prototypes
# =============================================================================
class SSCTrainer:
    def __init__(self, n_channels: int, n_timepoints: int, device: torch.device = OPTIMAL_DEVICE):
        self.classifier = SSCClassifier(n_channels, n_timepoints).to(device)
        self.device = device

    def train_from_dataset(self, data_loader, epochs: int = 10):
        """
        Learn prototypes p_mdd, p_hc and feature prototypes from labelled data.
        data_loader yields (batch_eeg, labels).
        """
        all_mdd = []
        all_hc = []
        for batch_data, labels in data_loader:
            batch_data = batch_data.to(self.device)
            for i in range(len(batch_data)):
                s = batch_data[i].flatten()
                if labels[i] == 1:
                    all_mdd.append(s)
                else:
                    all_hc.append(s)
        if all_mdd:
            self.classifier.p_mdd = torch.stack(all_mdd).mean(dim=0)
        if all_hc:
            self.classifier.p_hc = torch.stack(all_hc).mean(dim=0)
