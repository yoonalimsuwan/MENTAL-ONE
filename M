# =============================================================================
class SSCClassifier(nn.Module):
    """
    Deterministic, interpretable EEG/MEG classifier based on energy minimisation
    and multi‑scale contraction dynamics.
    Implements the theory from Sections 229‑242.
    """
    def __init__(self, n_channels: int, n_timepoints: int,
                 prototypes_mdd: Optional[torch.Tensor] = None,
                 prototypes_hc: Optional[torch.Tensor] = None,
                 feature_dim: int = 5,
                 eta: float = 0.009, gamma: float = 0.75, beta: float = 0.55,
                 w_alpha: float = 0.6, w_beta: float = 0.4, w_lambda: float = 0.3,
                 w_mu: float = 0.3):
        super().__init__()
        self.n_channels = n_channels
        self.n_timepoints = n_timepoints
        self.n_total = n_channels * n_timepoints
        self.eta = eta
        self.gamma = gamma
        self.beta = beta
        self.w_alpha = w_alpha
        self.w_beta = w_beta
        self.w_lambda = w_lambda
        self.w_mu = w_mu

        # Prototypes (learnable or fixed)
        if prototypes_mdd is not None:
            self.register_buffer('p_mdd', prototypes_mdd.reshape(-1))
        else:
            self.register_buffer('p_mdd', torch.zeros(self.n_total))
        if prototypes_hc is not None:
            self.register_buffer('p_hc', prototypes_hc.reshape(-1))
        else:
            self.register_buffer('p_hc', torch.zeros(self.n_total))

        # Feature extractor parameters (to be defined)
        self.feature_extractor = None  # Will be set in setup

        # Graph Laplacian for spatial regularisation
        self.register_buffer('L', self._build_laplacian())

    def _build_laplacian(self) -> torch.Tensor:
        """Build a simple ring‑graph Laplacian for 1D electrode layout."""
        n = self.n_channels
        A = torch.zeros((n, n))
        for i in range(n):
            A[i, (i-1)%n] = 1.0
            A[i, (i+1)%n] = 1.0
        D = torch.diag(A.sum(dim=1) + 1e-8)
        D_inv_sqrt = torch.linalg.inv(torch.sqrt(D))
        L = torch.eye(n) - D_inv_sqrt @ A @ D_inv_sqrt
        # Expand to full space (n_channels * n_timepoints) using Kronecker
        # For simplicity, we apply L on spatial dim only by reshaping
        # We'll use it in psi() by operating on reshaped tensor.
        return L

    def extract_features(self, s: torch.Tensor) -> torch.Tensor:
        """
        Compute neurophysiological features from semantic state s.
        s shape: (n_channels * n_timepoints)
        Returns feature vector of length feature_dim (e.g., FAA, band powers, connectivity)
        """
        # Reshape to (n_channels, n_timepoints)
        s_2d = s.reshape(self.n_channels, self.n_timepoints)
        # Simple band power features (using FFT)
        features = []
        # FAA: frontal alpha asymmetry (F3 vs F4, approximate)
        if self.n_channels >= 3:
            f3_idx = 2  # approximate
            f4_idx = 4
            alpha_power_f3 = torch.norm(s_2d[f3_idx])**2 / self.n_timepoints
            alpha_power_f4 = torch.norm(s_2d[f4_idx])**2 / self.n_timepoints
            faa = torch.log(alpha_power_f3 + 1e-8) - torch.log(alpha_power_f4 + 1e-8)
            features.append(faa)
        else:
            features.append(torch.tensor(0.0, device=s.device))
        # Theta / Beta ratio (global)
        fft = torch.fft.rfft(s_2d, dim=1)
        freqs = torch.fft.rfftfreq(self.n_timepoints, d=1/256)  # assume 256 Hz
        # Simple band integration (hardcoded)
        theta_mask = (freqs >= 4) & (freqs < 8)
        beta_mask = (freqs >= 13) & (freqs < 30)
        theta_power = torch.sum(torch.abs(fft[:, theta_mask])**2) / self.n_channels
        beta_power = torch.sum(torch.abs(fft[:, beta_mask])**2) / self.n_channels
        theta_beta_ratio = theta_power / (beta_power + 1e-8)
        features.append(theta_beta_ratio)
        # Alpha power
        alpha_mask = (freqs >= 8) & (freqs < 13)
        alpha_power = torch.sum(torch.abs(fft[:, alpha_mask])**2) / self.n_channels
        features.append(alpha_power)
        # Connectivity (mean correlation between channels)
        corr_mat = torch.corrcoef(s_2d)
        mean_corr = (corr_mat.sum() - self.n_channels) / (self.n_channels*(self.n_channels-1))
        features.append(mean_corr)
        # Temporal smoothness (mean diff)
        temporal_diff = torch.diff(s_2d, dim=1).norm()
        features.append(temporal_diff / self.n_timepoints)
        return torch.stack(features)

    def psi(self, s: torch.Tensor) -> torch.Tensor:
        """
        Multi‑scale operator Ψ(s) combining spatial Laplacian, bandpass,
        mean, variance, and temporal gradient.
        """
        s_2d = s.reshape(self.n_channels, self.n_timepoints)
        # 1. Spatial smoothing via Laplacian
        lap = self.L @ s_2d  # (n_channels, n_timepoints)
        lap_flat = lap.flatten()
        # 2. Bandpass filter (simple smooth via convolution)
        kernel = torch.tensor([-1, 2, -1], dtype=torch.float32, device=s.device)
        s_padded = F.pad(s_2d.unsqueeze(0), (1,1), mode='replicate')
        bandpass = F.conv1d(s_padded, kernel.view(1,1,-1), groups=1).squeeze(0)
        bandpass_flat = bandpass.flatten()
        # 3. Mean
        mu = s.mean()
        # 4. Variance
        var = s.var()
        # 5. Temporal gradient
        grad_t = torch.diff(s_2d, dim=1)
        grad_t_mean = grad_t.mean()
        # Combine with weights (w1=0.4, w2=0.25, w3=0.15, w4=0.1, w5=0.1)
        psi_val = (0.4 * lap_flat + 0.25 * bandpass_flat +
                   0.15 * mu + 0.1 * var + 0.1 * grad_t_mean)
        return psi_val

    def energy(self, s: torch.Tensor) -> torch.Tensor:
        """
        Total energy E(s) = α||s-p_mdd||² - β||s-p_hc||²
                            + λ||f(s)-f*_mdd||² - μ||f(s)-f*_hc||²
                            + γ Σ s_i(1-s_i)
        """
        f_s = self.extract_features(s)
        # Feature prototypes (will be learned)
        f_mdd = getattr(self, 'f_mdd', torch.zeros_like(f_s))
        f_hc = getattr(self, 'f_hc', torch.zeros_like(f_s))

        E = (self.w_alpha * torch.sum((s - self.p_mdd)**2) -
             self.w_beta * torch.sum((s - self.p_hc)**2) +
             self.w_lambda * torch.sum((f_s - f_mdd)**2) -
             self.w_mu * torch.sum((f_s - f_hc)**2) +
             self.gamma * torch.sum(s * (1 - s)))
        return E

    def contraction_update(self, s: torch.Tensor) -> torch.Tensor:
        """Single step of the contraction mapping T(s)."""
        grad = torch.autograd.grad(self.energy(s), s, create_graph=True)[0]
        psi_s = self.psi(s)
        s_next = s - self.eta * grad + self.beta * psi_s
        return torch.clamp(s_next, 0, 1)

    def forward(self, s0: torch.Tensor, n_iter: int = 25) -> torch.Tensor:
        """Evolve initial state s0 to fixed point s*."""
        s = s0
        for _ in range(n_iter):
            s = self.contraction_update(s)
        return s

    def classify(self, s_star: torch.Tensor) -> int:
        """Return 1 if MDD, 0 if HC based on energy."""
        E_mdd = self.w_alpha * torch.sum((s_star - self.p_mdd)**2)
        E_hc = self.w_beta * torch.sum((s_star - self.p_hc)**2)
        return 1 if E_mdd < E_hc else 0

    def learn_prototypes(self, data: torch.Tensor, labels: torch.Tensor):
        """Set prototypes from data: p_mdd = mean of MDD samples, etc."""
        mdd_mask = labels == 1
        hc_mask = labels == 0
        if mdd_mask.any():
            self.p_mdd = data[mdd_mask].mean(dim=0)
        if hc_mask.any():
            self.p_hc = data[hc_mask].mean(dim=0)
        # Feature prototypes
        if mdd_mask.any():
            f_mdd_samples = torch.stack([self.extract_features(d) for d in data[mdd_mask]])
            self.f_mdd = f_mdd_samples.mean(dim=0)
        if hc_mask.any():
            f_hc_samples = torch.stack([self.extract_features(d) for d in data[hc_mask]])
            self.f_hc = f_hc_samples.mean(dim=0)

