    def __init__(self, device: torch.device = OPTIMAL_DEVICE):
        self.device = device
        self.loader = MultiModalDataLoader(device=device)
        self.classifier = None  # Will be initialised per subject
        self.evolver = MentalHealthEvolution()
        self.intervention = InterventionDesigner()

    def run(self,
            eeg_file: Optional[str] = None,
            meg_file: Optional[str] = None,
            fmri_file: Optional[str] = None,
            clinical_file: Optional[str] = None,
            genetic_file: Optional[str] = None,
            diagnosis_hint: Optional[str] = None,
            n_iter: int = 25) -> Dict:

        # 1. Load data
        eeg = None
        if eeg_file:
            eeg = self.loader.load_eeg(eeg_file)
        elif meg_file:
            meg = self.loader.load_meg(meg_file)
            eeg = meg  # treat same for now

        if eeg is None:
            raise ValueError("At least EEG or MEG file required.")

        # Flatten EEG to semantic state s0
        s0 = eeg.flatten()
        s0 = (s0 - s0.min()) / (s0.max() - s0.min() + 1e-8)

        # 2. Initialise SSC classifier (prototypes can be pre‑loaded)
        n_channels, n_timepoints = eeg.shape
        self.classifier = SSCClassifier(n_channels=n_channels,
                                        n_timepoints=n_timepoints).to(self.device)

        # If prototypes not set, we need to load them from a pre‑trained file
        # For demonstration, we'll use random prototypes (should be replaced)
        if torch.all(self.classifier.p_mdd == 0):
            logger.warning("Prototypes not loaded; using random. Please train or load pre‑trained.")
            self.classifier.p_mdd = torch.rand_like(s0)
            self.classifier.p_hc = torch.rand_like(s0)

        # 3. Run SSC evolution
        s_star = self.classifier(s0, n_iter=n_iter)

        # 4. Classify
        pred_class = self.classifier.classify(s_star)
        diagnosis = 'MDD' if pred_class == 1 else 'Healthy'
        if diagnosis_hint:
            diagnosis = diagnosis_hint  # override with clinical hint

        # 5. Compute disease burden trajectory (simulated from EEG features)
        # Here we use mean activation as proxy for mu
        mu_sequence = s_star.reshape(n_channels, n_timepoints).mean(dim=0)  # (time,)
        mu_sequence = torch.clamp(mu_sequence, 0, 1)

        # 6. Evolutionary prediction
        evo_result = self.evolver(mu_sequence, steps=50)
        future = evo_result['future']
        entropy = evo_result['entropy'].item()
        risk = 'High' if future[-1] > 0.7 else ('Moderate' if future[-1] > 0.4 else 'Low')

        # 7. Intervention design (if needed)
        treatment_plan = None
        if diagnosis != 'Healthy':
            desired_state = self.classifier.p_hc  # target healthy prototype
            treatment_plan = self.intervention.design_plan(diagnosis, s_star, desired_state)

        # 8. Optional genetic analysis (via EVOLUTION ONE)
        genetic_report = None
        if genetic_file and HAS_EVO:
            try:
                evo_engine = EvolutionONEEngine()
                evo_engine.run(input_file=genetic_file, genes=['SLC6A4','COMT','BDNF'],
                               format='vcf', compute_future_mutations=False,
                               compute_structural=False)
                genetic_report = evo_engine.results
            except Exception as e:
                logger.warning(f"EVOLUTION ONE genetic analysis failed: {e}")

        # Assemble report
        report = {
            'diagnosis': diagnosis,
            'confidence': float(torch.sigmoid(torch.tensor(0.0))),  # placeholder
            'fixed_point_state': s_star.cpu().tolist(),
            'disease_burden_trajectory': mu_sequence.cpu().tolist(),
            'future_trajectory': future.cpu().tolist(),
            'entropy': entropy,
            'risk_level': risk,
            'treatment_plan': treatment_plan,
            'genetic_report': genetic_report
        }
        return report

