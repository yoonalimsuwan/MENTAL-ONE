class InterventionDesigner:
    """
    Designs pharmacological, psychotherapeutic, and environmental interventions
    to shift the patient's attractor from pathological to healthy.
    Based on control theory (Sections 240‑241).
    """
    def __init__(self, drug_db: str = None):
        # In practice, load drug‑target interaction database.
        self.psychiatric_drugs = {
            'MDD': ['SSRI (Fluoxetine)', 'SNRI (Venlafaxine)', 'Bupropion'],
            'Bipolar': ['Lithium', 'Valproate', 'Lamotrigine'],
            'Schizophrenia': ['Olanzapine', 'Risperidone', 'Clozapine'],
            'PTSD': ['Sertraline', 'Paroxetine', 'Prazosin'],
            'Panic': ['Alprazolam', 'Clonazepam', 'Paroxetine'],
            'Anxiety': ['Buspirone', 'Escitalopram'],
        }
        self.therapy_modalities = {
            'MDD': ['CBT', 'IPT', 'Mindfulness'],
            'Bipolar': ['CBT', 'Family‑focused therapy'],
            'Schizophrenia': ['CBT‑p', 'Social skills training'],
            'PTSD': ['Prolonged Exposure', 'EMDR', 'CBT‑T'],
            'Panic': ['CBT‑Panic', 'Interoceptive exposure'],
        }
        self.environmental = ['Sleep hygiene', 'Exercise routine', 'Dietary adjustments',
                              'Stress reduction', 'Social support enhancement']

    def design_plan(self, diagnosis: str, current_state: torch.Tensor,
                    desired_state: torch.Tensor) -> Dict:
        """
        Generate a multi‑modal treatment plan.
        Uses control law: U = -K (s - s_healthy).
        """
        plan = {}
        # Pharmacological
        drugs = self.psychiatric_drugs.get(diagnosis, [])
        if drugs:
            plan['medication'] = random.sample(drugs, min(3, len(drugs)))
        # Psychotherapy
        therapies = self.therapy_modalities.get(diagnosis, [])
        if therapies:
            plan['psychotherapy'] = random.sample(therapies, min(2, len(therapies)))
        # Environmental
        plan['lifestyle'] = random.sample(self.environmental, 3)
        # Control gain estimation (simplified)
        error = desired_state - current_state
        K = torch.norm(error) / (torch.norm(current_state) + 1e-8)
        plan['control_gain'] = K.item()
        plan['target_state'] = desired_state.tolist()
        return plan

