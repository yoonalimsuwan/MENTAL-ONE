# 4. Mental Health Evolutionary Engine (SOC + RG + Ito)
# =============================================================================
class MentalHealthEvolution(nn.Module):
    """
    Uses SOC and RG to model disease trajectory as a dynamical system.
    Predicts future state (remission, chronic, crisis) and entropy.
    """
    def __init__(self, base_temp: float = 300.0, friction: float = 0.02,
                 sigma_target: float = 1.0, rg_factor: int = 4):
        super().__init__()
        self.soc = SOCController(base_temp, friction, sigma_target)
        self.rg = DiffRGRefiner(factor=rg_factor, n_levels=2)

    def forward(self, mu_sequence: torch.Tensor, steps: int = 50) -> Dict[str, torch.Tensor]:
        """
        Input: mu_sequence (N,) – current disease burden over time.
        Output: predicted future trajectory, entropy, criticality.
        """
        mu_smooth = self.rg(mu_sequence)
        future = self.soc.soc_evolve(mu_smooth, steps=steps)
        sigma = self.soc.sigma(mu_smooth)
        T = self.soc.temperature(sigma)
        return {
            'future': future,
            'sigma': sigma,
            'temperature': T,
            'entropy': self._entropy(future)
        }

    def _entropy(self, x: torch.Tensor) -> torch.Tensor:
        hist = torch.histc(x, bins=10, min=0, max=1)
        p = hist / hist.sum()
        p = p[p > 0]
        return -torch.sum(p * torch.log(p))

# ---------------------------------------------------------------------------
# Simplified SOC/RG components (mirroring EVOLUTION ONE)
# ---------------------------------------------------------------------------
class SOCController(nn.Module):
    def __init__(self, base_temp=300, friction=0.02, sigma_target=1.0):
        super().__init__()
        self.base_temp = base_temp
        self.friction = friction
        self.sigma_target = sigma_target
        self.prev = None
    def sigma(self, x):
        if self.prev is None:
            self.prev = x.detach().clone()
            return torch.tensor(1.0, device=x.device)
        delta = torch.norm(x - self.prev).mean()
        self.prev = x.detach().clone()
        return delta
    def temperature(self, sigma):
        T = self.base_temp + 2000 * torch.sigmoid((sigma - self.sigma_target)/0.5)
        return torch.clamp(T, 100, 3000)
    def soc_evolve(self, x, steps=10):
        for _ in range(steps):
            sigma = self.sigma(x)
            T = self.temperature(sigma)
            noise = torch.randn_like(x) * T * 0.01
            x = x + noise
            x = torch.clamp(x, 0, 1)
        return x

class DiffRGRefiner(nn.Module):
    def __init__(self, factor=4, n_levels=2):
        super().__init__()
        self.factor = factor
        self.n_levels = n_levels
    def forward(self, x):
        if x.dim() == 1:
            x = x.unsqueeze(0)  # (1, N)
        # simple avg pooling and upscale
        for _ in range(self.n_levels):
            L = x.shape[1]
            f = self.factor
            m = L // f * f
            if m == 0: break
            pooled = F.avg_pool1d(x[:, :m].unsqueeze(0), kernel_size=f, stride=f)
            up = F.interpolate(pooled, size=L, mode='linear', align_corners=True)
            x = up.squeeze(0)
        return x.squeeze(0) if x.shape[0]==1 else x

