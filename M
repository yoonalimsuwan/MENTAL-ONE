class MultiModalDataLoader:
    """
    Handles EEG (EDF, CSV), MEG (FIF), fMRI (NIfTI), clinical (CSV),
    and genetic (VCF/MAF) data ingestion with appropriate preprocessing.
    """
    def __init__(self, device: torch.device = OPTIMAL_DEVICE):
        self.device = device

    def load_eeg(self, file_path: str, montage: str = 'standard_1020') -> torch.Tensor:
        """
        Load EEG from EDF or CSV. Returns tensor (n_channels, n_timepoints).
        """
        if file_path.endswith('.edf') and HAS_MNE:
            raw = mne.io.read_raw_edf(file_path, preload=True)
            # Pick only EEG channels, exclude EOG etc.
            raw.pick_types(eeg=True)
            data, _ = raw[:]
            # Resample to 256 Hz if necessary
            if raw.info['sfreq'] != 256:
                raw.resample(256)
                data, _ = raw[:]
            # Bandpass filter 1-40 Hz
            raw.filter(1, 40, fir_design='firwin')
            data, _ = raw[:]
            return torch.tensor(data, dtype=torch.float32, device=self.device)
        elif file_path.endswith('.csv'):
            df = pd.read_csv(file_path)
            data = df.values.T  # assume rows=time, cols=channels
            return torch.tensor(data, dtype=torch.float32, device=self.device)
        else:
            raise ValueError("Unsupported EEG format. Use EDF or CSV.")

    def load_meg(self, file_path: str) -> torch.Tensor:
        """Load MEG from FIF file using MNE. Returns (n_channels, n_timepoints)."""
        if not HAS_MNE:
            raise ImportError("MNE‑Python required for MEG loading.")
        raw = mne.io.read_raw_fif(file_path, preload=True)
        raw.pick_types(meg=True)
        data, _ = raw[:]
        return torch.tensor(data, dtype=torch.float32, device=self.device)

    def load_fmri(self, file_path: str, mask: str = 'brain') -> torch.Tensor:
        """
        Load fMRI (NIfTI). Returns flattened brain voxels (1D tensor).
        """
        if not HAS_NILEARN:
            raise ImportError("Nilearn required for fMRI loading.")
        img = nib.load(file_path)
        if mask == 'brain':
            from nilearn.masking import compute_epi_mask
            mask_img = compute_epi_mask(img)
            masked = masking.apply_mask(img, mask_img)
            return torch.tensor(masked, dtype=torch.float32, device=self.device)
        else:
            data = img.get_fdata()
            return torch.tensor(data.flatten(), dtype=torch.float32, device=self.device)

    def load_clinical(self, file_path: str) -> pd.DataFrame:
        """Load clinical assessments (CSV). Returns DataFrame."""
        return pd.read_csv(file_path)

    def load_genetic(self, file_path: str, format: str = 'vcf') -> pd.DataFrame:
        """Load genetic variants (VCF/MAF). Returns DataFrame with Hugo_Symbol, etc."""
        if format == 'vcf':
            return self._load_vcf(file_path)
        elif format == 'maf':
            return pd.read_csv(file_path, sep='\t', comment='#', low_memory=False)
        else:
            raise ValueError("Unsupported genetic format.")

    def _load_vcf(self, file_path: str) -> pd.DataFrame:
        records = []
        with open(file_path) as f:
            for line in f:
                if line.startswith('#'): continue
                fields = line.strip().split('\t')
                if len(fields) < 8: continue
                chrom, pos, _, ref, alt, _, _, info = fields[:8]
                gene = 'UNKNOWN'
                if 'GENE=' in info:
                    gene = info.split('GENE=')[1].split(';')[0]
                records.append({
                    'Chromosome': chrom,
                    'Start_Position': int(pos),
                    'Reference_Allele': ref,
                    'Tumor_Seq_Allele2': alt,
                    'Hugo_Symbol': gene
                })
        return pd.DataFrame(records)

